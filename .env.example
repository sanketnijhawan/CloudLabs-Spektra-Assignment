# Optional Gemini configuration. Copy to .env, uncomment, and add your own key.
# npm start loads .env automatically. No model is needed for manual controls.
# AI_API_KEY=YOUR_GEMINI_KEY
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# Other OpenAI-compatible providers may use their own base URL and model.
# PORT=3000
# DB_PATH=./data/workshop.db
